<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ server_name }} — New Arrivals</title>
</head>
<body style="font-family: 'Courier New', Courier, monospace; max-width: 640px; margin: 0 auto; background: #0a0a0a; color: #0f0; padding: 24px;">

  <header style="text-align: center; padding: 32px 0; border-bottom: 3px dashed #0f0;">
    <pre style="margin: 0; font-size: 12px; color: #0a0;">
    </pre>
    <h1 style="margin: 0; font-size: 26px; text-transform: uppercase; letter-spacing: 4px;">{{ server_name }}</h1>
    <p style="margin: 8px 0 0; color: #0a0; font-size: 14px;">▶ NEW ARRIVALS ◀</p>
  </header>

  {% if items_added %}
    <main>
      {% for item in items_added %}
        <article style="background: #000; border: 1px solid #0f0; padding: 14px; margin-bottom: 14px;">
          <h2 style="margin: 0; font-size: 16px; color: #fff; text-transform: uppercase;">{{ item.Name }}</h2>
          <div style="margin-top: 4px; font-size: 12px; color: #0a0;">
            [{{ item.Type }}]
            {% if item.ProductionYear %} {{ item.ProductionYear }}{% endif %}
            {% if item.LibraryName %} · {{ item.LibraryName }}{% endif %}
          </div>
          {% if item.Overview %}
            <p style="margin-top: 8px; font-size: 12px; color: #0c0; line-height: 1.4;">&gt; {{ item.Overview | truncate(180) }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </main>
  {% else %}
    <p style="text-align: center; color: #0a0; font-size: 14px;">[ NO SIGNAL — check back later ]</p>
  {% endif %}

  {% if custom_news %}
    <footer style="margin-top: 32px; padding: 16px; background: #000; border: 1px dashed #0f0;">
      <h2 style="font-size: 14px; margin: 0 0 8px; color: #fff;">📼 BROADCAST</h2>
      <p style="margin: 0; font-size: 13px; color: #0f0;">{{ custom_news }}</p>
    </footer>
  {% endif %}

  <p style="text-align: center; margin-top: 32px; font-size: 11px; color: #0a0;">
    Sent by JellyNews &middot; {{ generated_at }}
  </p>

</body>
</html>
